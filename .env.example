# Copy to .env and fill in to turn on accounts, cloud sync, leaderboards, online duels and the AI tutor.
# Leave both blank to run in local mode (progress saved in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. C++ and Java are compiled on a Piston sandbox service. Point this at your own instance
# (https://github.com/engineer-man/piston) if the default public endpoint is unavailable to you.
# VITE_PISTON_URL=https://your-piston-host/api/v2/piston
