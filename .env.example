# Copy to .env and fill in to turn on accounts, cloud sync, leaderboards, online duels and the AI tutor.
# Leave both blank to run in local mode (progress saved in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Needed for C++ and Java only. They compile on a Piston sandbox server that you host
# (https://github.com/engineer-man/piston). The public Piston API has been whitelist-only since
# February 2026, so there is no default. Python, JavaScript, SQL, HTML and CSS need nothing.
# VITE_PISTON_URL=https://your-piston-host/api/v2/piston
