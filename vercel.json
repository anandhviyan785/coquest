{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:root(login|learn|lesson|boss|leaderboard|quests|shop|profile|bosses|settings|playground|daily|duels|stats)/:rest*", "destination": "/index.html" },
    { "source": "/:root(login|learn|lesson|boss|leaderboard|quests|shop|profile|bosses|settings|playground|daily|duels|stats)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
